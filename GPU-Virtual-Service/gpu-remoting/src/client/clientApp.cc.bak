    // tool::Logging(myName, "pCaptureStatusofStream = %d, size = %zu\n", pCaptureStatusofStream, tmp4);
    // recv pId

    reqBuf_4.Reset(sizeof(enum cudaStreamCaptureStatus*)+sizeof(unsigned long long *), reqBuf_4._dataBuffer);

    ucp_dt_iov_t *recv_iov5;
    PrepareSingleIOV(&recv_iov5, reqBuf_4._dataBuffer, sizeof(enum cudaStreamCaptureStatus*)+sizeof(unsigned long long *));
    size_t tmp5 = 0;
    ReceiveData(recv_iov5, &tmp5, reqBuf_4._dataBuffer, 0, &clientEp->_dataWorker, UCS_MEMORY_TYPE_HOST, NULL);
    pCaptureStatus = reqBuf_4.Pop<enum cudaStreamCaptureStatus>();
    pId = reqBuf_4.Pop<unsigned long long>();
    printf("cudaStreamGetCaptureInfo success, status = %d, pId = %lld\n", pCaptureStatus, pId);
    


    // req5: cudaStreamDestroy
